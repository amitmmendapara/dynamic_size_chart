PORT=

# Either set DATABASE_URL...
DATABASE_URL= Postgres connection url

# ...or the individual PG* vars (DATABASE_URL wins if both are set)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=sizechart_db
# PGUSER=postgres
# PGPASSWORD=postgres

# Where uploaded size-chart images are written and served from
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PATH=/uploads
MAX_IMAGE_SIZE_MB=5

CORS_ORIGIN=frontend url with port